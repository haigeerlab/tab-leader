{
  "compilerOptions": {
    "target": "ES2017",
    // Only ES2017 built-ins: using a newer API (Object.hasOwn, Array.prototype.at, ...) fails typecheck.
    "lib": ["ES2017", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src"]
}
