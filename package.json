{
  "name": "tab-leader",
  "version": "0.1.0",
  "description": "Elect one leader among same-origin browser tabs, take over from frozen leaders, and fall back to localStorage leases on browsers without Web Locks.",
  "keywords": [
    "tab",
    "leader",
    "leader-election",
    "web-locks",
    "localStorage",
    "cross-tab",
    "multi-tab"
  ],
  "license": "MIT",
  "author": "haigeerlab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haigeerlab/tab-leader.git"
  },
  "homepage": "https://github.com/haigeerlab/tab-leader#readme",
  "bugs": "https://github.com/haigeerlab/tab-leader/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "browserslist": [
    "chrome >= 80",
    "edge >= 80",
    "firefox >= 74",
    "safari >= 13.1",
    "ios_saf >= 12.4"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:terms": "node scripts/check-internal-terms.mjs",
    "demo": "pnpm build && node scripts/serve.mjs",
    "test:browser": "pnpm build && playwright test",
    "verify:consumers": "node scripts/verify-consumers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.65.0",
    "@types/node": "~24.19.2",
    "@vitest/coverage-v8": "~5.1.0",
    "acorn": "~8.19.0",
    "eslint": "~10.14.0",
    "eslint-plugin-compat": "~7.0.2",
    "globals": "^17.14.0",
    "prettier": "~3.10.1",
    "tsdown": "~0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "vitest": "~5.1.0"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
